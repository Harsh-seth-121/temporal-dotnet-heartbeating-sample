<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>starter</AssemblyName>
    <RootNamespace>Repro.Starter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Repro.Core\Repro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Temporalio.Extensions.DiagnosticSource" />
    <PackageReference Include="prometheus-net" />
  </ItemGroup>

  <ItemGroup>
    <!-- So `dotnet run —project src/Repro.Starter` works with no —config flag, exactly
         like `go run ./cmd/starter` did from the repo root. -->
    <None Include="..\..\config.yaml" Link="config.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
