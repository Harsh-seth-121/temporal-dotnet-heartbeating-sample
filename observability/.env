# MUST NOT collide with any other Temporal sandbox on this machine. The Go
# repo this project is ported from uses `temporal-sandbox`; sharing that name
# means `docker compose up` here silently ADOPTS that stack's containers and
# volumes, and `down -v` from either repo wipes the other's data.
COMPOSE_PROJECT_NAME=temporal-dotnet-sandbox

# 1.31.2 matches the host CLI's embedded server (temporal version -> Server 1.31.2).
# Verified 2026-08-27 against the local CLI: `temporal version` reports Server 1.31.2.
# Still the newest server release; there is no 1.32.x.
# NOTE: temporalio/auto-setup has NO 1.31.x tag -- deprecated at 1.29.7.
TEMPORAL_VERSION=1.31.2
# admin-tools uses plain server versioning on 1.30+. Ships temporal CLI,
# temporal-sql-tool, tdbg, and /etc/temporal/schema.
TEMPORAL_ADMINTOOLS_VERSION=1.31.2
# The Web UI versions INDEPENDENTLY of the server; 2.53.x talks to 1.31.2 fine.
# CLI 1.8.1 embeds 2.50.1, but that is a CLI packaging detail, not a compatibility
# constraint. This is the one pin in this file not locked to the server version,
# so it is also the one most likely to need a rollback: if localhost:8080 fails to
# list namespaces, drop to 2.50.1.
TEMPORAL_UI_VERSION=2.53.3
POSTGRESQL_VERSION=16.15-alpine
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
