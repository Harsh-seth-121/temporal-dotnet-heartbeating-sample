{
  "uid": "sandbox-server",
  "title": "Repro / Server and Persistence",
  "description": "Server-sourced view from the containerized Temporal server on :8000: frontend RPS and latency, persistence, matching, and task queue backlog. Unchanged by the Go -> .NET port: same server binary, same tally metrics, latency units are SECONDS.",
  "tags": [
    "sandbox",
    "server"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Frontend availability",
      "description": "'or vector(0)' matters: without it this panel goes blank when there are no errors, which reads as broken rather than healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (sum(rate(service_errors{service_name=\"frontend\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(service_requests{service_name=\"frontend\"}[$__rate_interval])), 1e-9))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "State transitions /s",
      "description": "Mutable-state writes. Uses _count, never _sum: the metric records each workflow's cumulative value on close, so _sum is meaningless.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(state_transition_count_count[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "transitions/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sync-match ratio",
      "description": "1.0 means tasks handed straight to a waiting poller and never touched the database. Drops when workers fall behind.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(poll_success_sync[$__rate_interval])) / clamp_min(sum(rate(poll_success[$__rate_interval])), 1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "sync-match"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Frontend RPS by operation",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(service_requests{service_name=\"frontend\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Frontend latency p95 by operation",
      "description": "Server histograms are in SECONDS. The SDK's are in milliseconds -- do not put these two on one axis without converting.\n\nServer counters carry no _total suffix because tally emits classic text format, not OpenMetrics. The SDK's counters also carry no _total suffix, but for a completely unrelated reason: Core's HasCounterTotalSuffix defaults to false. Same shape, two causes; flipping the SDK flag would not change anything on this board.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(service_latency_bucket{service_name=\"frontend\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Persistence latency p95 by operation",
      "description": "PostgreSQL here. Do not extrapolate these numbers to Cassandra.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(persistence_latency_bucket{service_name=\"history\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Persistence requests /s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(persistence_requests{service_name=\"history\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Server-side schedule-to-start p95",
      "description": "History service's own view, in seconds. Compare with the SDK's view on the Signals board -- that panel converts this series to milliseconds so the two are comparable. Sustained divergence means clock skew or dispatch loss.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (task_type, le) (rate(task_schedule_to_start_latency_bucket{service_name=\"history\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{task_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Workflow outcomes, server view",
      "description": "Server label keys differ from SDK ones: workflowType (camelCase) here, workflow_type there. That gap widened in the .NET port -- the SDK side is now unambiguously snake_case because Core does no name mangling at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workflowType) (rate(workflow_success{namespace=\"default\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{workflowType}} success"
        },
        {
          "refId": "B",
          "expr": "sum by (workflowType) (rate(workflow_failed{namespace=\"default\"}[$__rate_interval])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{workflowType}} failed"
        },
        {
          "refId": "C",
          "expr": "sum by (workflowType) (rate(workflow_timeout{namespace=\"default\"}[$__rate_interval])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{workflowType}} timeout"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Task queue backlog",
      "description": "Backlog count and age. Two label traps in one panel.\n\nKEY: it is 'taskqueue' on the server, without the underscore the SDK uses.\nVALUE: the server SANITIZES tag values (tally replaces anything non-alphanumeric with an underscore) and Core does NOT. A queue named heartbeat-task-queue is taskqueue=\"heartbeat_task_queue\" here and task_queue=\"heartbeat-task-queue\" on every SDK board. Same queue, two spellings, no join.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (taskqueue, task_type) (approximate_backlog_count)",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{taskqueue}} {{task_type}} count"
        },
        {
          "refId": "B",
          "expr": "max by (taskqueue, task_type) (approximate_backlog_age_seconds)",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{taskqueue}} {{task_type}} age (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tasks arriving with no poller /s",
      "description": "Non-zero means tasks landed with nobody polling -- a stopped worker, or a task queue name mismatch.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (taskqueue) (rate(no_poller_tasks[$__rate_interval])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{taskqueue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Errors by type, all roles",
      "description": "Empty when healthy. All server roles share one process on this deployment, so service_name distinguishes them: frontend, history, matching, worker.\n\nCareful: service_name is no longer server-only. Core attaches service_name=\"temporal-core-sdk\" to every SDK metric. Different metric families, so nothing collides here, but do not read service_name as 'server role' the way you could in the Go repo.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, error_type) (rate(service_error_with_type[$__rate_interval])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "{{service_name}} {{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "History cache lock contention p99",
      "description": "HistoryCacheGetOrCreate latency. Climbs when many workers contend on the same workflow.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(cache_latency_bucket{operation=\"HistoryCacheGetOrCreate\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
