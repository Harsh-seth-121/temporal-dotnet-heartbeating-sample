{
  "uid": "sandbox-heartbeat",
  "title": "Repro / Heartbeating",
  "description": "The seed case's own board. No Core SDK has a heartbeat metric, so every panel here is a proxy (the RecordActivityTaskHeartbeat RPC), a server-side consequence (activity_task_timeout), or something this repo emits itself. Start at 'Heartbeat interval: asked for vs throttled vs observed'.",
  "tags": [
    "sandbox",
    "heartbeat"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "SDK namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "sandbox-prometheus"
        },
        "query": "label_values(temporal_request{service_name=\"temporal-core-sdk\"}, namespace)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "default",
          "value": "default",
          "selected": true
        },
        "description": "Values are NOT sanitized by the .NET SDK; dashes survive."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Heartbeat RPCs /s",
      "description": "The only built-in heartbeat signal in any Core SDK. Counts RecordActivityTaskHeartbeat calls that actually reached the server, i.e. AFTER Core's throttle. It is a normal request, not a long poll -- Core only marks the poll RPCs as long -- so it lands in temporal_request, never temporal_long_request. On Temporal Cloud each of these is a billable Action.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(temporal_request{namespace=\"$namespace\",service_name=\"temporal-core-sdk\",operation=\"RecordActivityTaskHeartbeat\"}[$__rate_interval])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "heartbeat RPCs/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Heartbeat timeouts (dashboard range)",
      "description": "The authoritative signal that an activity stopped heartbeating in time, from the server's timer queue. Self-hosted only: this metric is not exposed in Temporal Cloud. Present in server 1.31.2 as activity_task_timeout{timeout_type=\"Heartbeat\"}, tagged operation=\"TimerActiveTaskActivityTimeout\". NOTE: there is no metric called heartbeat_timeout in server 1.31.2 -- activity timeouts are one counter split by a timeout_type label. increase() over the range, not rate(), so a single fault still registers.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(activity_task_timeout{namespace=\"default\",operation=\"TimerActiveTaskActivityTimeout\",timeout_type=\"Heartbeat\"}[$__range])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "heartbeat timeouts"
        }
      ],
      "fieldConfig": {
