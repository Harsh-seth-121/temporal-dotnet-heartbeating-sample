    {
      "id": 12,
      "type": "timeseries",
      "title": "Activity schedule-to-start p95, SDK vs server",
      "description": "Two independent views of how long an ACTIVITY task sat in the queue. The server series is multiplied by 1000: server timers are seconds, Core histograms are milliseconds. Both need the schedule-to-start bucket override on the SDK side; the server's buckets are tally's and are fine.\n\nThe server histogram is shared by both task types, so it is pinned to task_type=\"Activity\" here -- unpinned it also plots workflow tasks, which the SDK series opposite it does not measure.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(temporal_activity_schedule_to_start_latency_bucket{namespace=\"$namespace\",service_name=\"temporal-core-sdk\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "SDK (worker), ms"
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(task_schedule_to_start_latency_bucket{service_name=\"history\",task_type=\"Activity\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "SERVER (history), s -> ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Attempts resuming from a checkpoint",
      "description": "Fraction of activity attempts that started from a heartbeat detail rather than from scratch. Reads 0 when nothing is failing; raise fault.failureRate or fault.stallPastHeartbeatTimeout and watch it climb.\n\nIn .NET there is no HasHeartbeatDetails helper -- the app checks ctx.Info.HeartbeatDetails.Count > 0 and tags this counter with the answer. HeartbeatDetailAtAsync<T>(0) throws if you skip the check.",
      "datasource": {
        "type": "prometheus",
        "uid": "sandbox-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(repro_activity_started{namespace=\"$namespace\",service_name=\"temporal-core-sdk\",resumed=\"true\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(repro_activity_started{namespace=\"$namespace\",service_name=\"temporal-core-sdk\"}[$__rate_interval])), 1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "sandbox-prometheus"
          },
          "legendFormat": "resumed fraction"
        }
      ],
      "fieldConfig": {
        "defaults": {
