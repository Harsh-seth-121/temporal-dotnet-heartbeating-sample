            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Running heartbeating activities",
      "description": "Used activity slots. This repo has exactly one activity type and it always heartbeats, so this is the divisor that turns a heartbeat RATE into a per-activity INTERVAL on the panel below.",
