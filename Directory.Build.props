<Project>

  <PropertyGroup>
    <!-- .NET 10 is the current LTS (GA 2025-11-11, EOL 2028-11-14); .NET 8 and 9 both
         go EOL 2026-11-10. Temporalio targets netstandard2.0, so it loads here without a
         net10.0-specific asset. Nothing here needs a net9/net10 language or BCL feature,
         so this line plus global.json are the only two places to change. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Warnings are errors because the failure modes this repo documents are mostly
         silent. A stale obsolete-API warning, such as YamlDotNet's naming-convention
         constructors, should stop the build rather than scroll past. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Recommended, not AllEnabledByDefault: this is a repro sandbox meant to be read
         and edited fast, and StyleCop-grade enforcement adds friction for no signal. -->
    <AnalysisMode>Recommended</AnalysisMode>

    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
